{
  "auth": {
    "forbidden": {
      "credentialEnv": "API_FORBIDDEN_TOKEN",
      "operations": [
        "listOrders"
      ]
    },
    "expired": {
      "credentialEnv": "API_EXPIRED_TOKEN"
    }
  },
  "scenarios": [
    {
      "create": "createOrder",
      "idFrom": "/id",
      "param": "orderId",
      "read": "getOrder",
      "update": "updateOrder",
      "delete": "deleteOrder",
      "conflictOn": [
        "customer"
      ],
      "echoes": [
        "total",
        "status"
      ]
    }
  ]
}
