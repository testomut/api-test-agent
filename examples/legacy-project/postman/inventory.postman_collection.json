              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman item\",\"price\":7}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"itemId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Created",
              "code": 201
            }
          ]
        },
        {
