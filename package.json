{
  "name": "@testomut/api-test-agent",
  "version": "0.1.0",
  "description": "CLI that audits an OpenAPI spec against a test API, runs contract checks and generates reviewable Playwright API tests",
  "scripts": {
    "agent": "tsx src/cli.ts",
    "demo": "tsx demo-api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "playwright test",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "author": "Stanislav Mokshyn",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@babel/parser": "^8.1.0",
    "@redocly/openapi-core": "^2.76.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/types": "^8.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "api-test-agent": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src/contract/validator.ts",
    "README.md",
    "LICENSE",
    "skills",
    "docs"
  ],
  "keywords": [
    "openapi",
    "api-testing",
    "contract-testing",
    "playwright",
    "schemathesis",
    "qa",
    "test-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testomut/api-test-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
