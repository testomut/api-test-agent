{
  "auth": {
    "forbidden": {
      "credentialEnv": "API_FORBIDDEN_TOKEN",
      "operations": [
        "getMe"
      ]
    },
    "expired": {
      "credentialEnv": "API_EXPIRED_TOKEN"
    }
  },
  "scenarios": [
    {
      "create": "createItem",
      "idFrom": "/id",
      "param": "itemId",
      "read": "getItem",
      "update": "updateItem",
      "delete": "deleteItem",
      "collection": {
        "operationId": "listItems",
        "items": "/items",
        "id": "/id",
        "fields": {
          "/name": "exact",
          "/price": "tolerance:0.001",
          "/tags": "exact",
          "/createdAt": "ignore"
        },
        "unique": [
          "/id"
        ],
        "filters": [
          {
            "param": "tag",
            "field": "/tags",
            "match": "contains"
          }
        ],
        "sorts": [
          {
            "param": "sort",
            "value": "name",
            "field": "/name",
            "order": "asc"
          },
          {
            "param": "sort",
            "value": "-name",
            "field": "/name",
            "order": "desc"
          },
          {
            "param": "sort",
            "value": "price",
            "field": "/price",
            "order": "asc"
          },
          {
            "param": "sort",
            "value": "-price",
            "field": "/price",
            "order": "desc"
          }
        ],
        "page": {
          "style": "offset",
          "offsetParam": "offset",
          "limitParam": "limit",
          "maxPages": 20
        },
        "deletedDisappears": true
      }
    }
  ]
}
